# Public: safe to expose to browsers.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=
PUBLIC_COLLECTIVE_PENDING=true
PUBLIC_COLLECTIVE_SLUG=
PUBLIC_ORGANIZER_SLUG=

# Secret: server only. Never commit a value for these.
SUPABASE_SECRET_KEY=
# Raises GitHub's limit on the existing-repo search. A token with no extra permissions is enough.
GITHUB_TOKEN=
# Comma-separated GitHub user ids allowed to use /admin.
ADMIN_GITHUB_IDS=
# Key for the daily visitor hash used in page-view counts. Any long random string.
# If unset, the Supabase secret key is used; if neither is set, nothing is counted.
ANALYTICS_SALT=
# Sends email through Resend. If unset, no email is sent and nothing else changes.
RESEND_API_KEY=
