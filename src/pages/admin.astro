---
import AdminNav from '../components/AdminNav.astro';
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { when } from '../lib/adminNav';
import { attempt, getReport, isAdmin } from '../lib/db';
import { EVENT_KINDS, EVENT_LABELS } from '../lib/events';
import { bars, change, percent, type Counted } from '../lib/report';
import { sourceName, taggedLinks } from '../lib/sources';

// Organizer only. Everyone else, signed in or not, gets a plain 404.
if (!isAdmin(Astro.locals.person)) return new Response(null, { status: 404 });

const humans = Astro.url.searchParams.get('humans') === '1';
// The toggle needs to say how many it would leave out, which only the full count knows.
const [a, everyone] = await Promise.all([attempt(() => getReport(humans)), humans ? attempt(() => getReport(false)) : null]);
const marked = (everyone ?? a)?.totals.d30.automated ?? 0;

const n = (v: number) => v.toLocaleString('en-US');
const periods = [['today', 'Today'], ['yesterday', 'Yesterday'], ['d7', 'Last 7 days'], ['d30', 'Last 30 days']] as const;
const delta = a ? change(a.totals.today.visitors, a.totals.yesterday.visitors) : null;
const W = 600;
const H = 150;
const hourBars = a ? bars(a.hourly.map((h) => h.visitors), W, H) : [];
const dayBars = a ? bars(a.daily.map((d) => d.visitors), W, H) : [];
const hourPeak = a ? Math.max(0, ...a.hourly.map((h) => h.visitors)) : 0;
const dayPeak = a ? Math.max(0, ...a.daily.map((d) => d.visitors)) : 0;
const did = (e: Partial<Record<string, number>>, ...kinds: string[]) => kinds.reduce((sum, k) => sum + (e[k] ?? 0), 0);
const tables: [string, string, Counted[] | undefined, string][] = [
  ['Landing pages', 'The first page of each visit.', a?.landings, 'No visits yet.'],
  ['All pages', 'Every page view, wherever in the visit it came.', a?.pages, 'No page views yet.'],
  ['Countries', 'From the hosting provider. Two letters, nothing finer.', a?.countries, 'No visitors yet.'],
  ['Devices', 'Phone, tablet or computer. Recorded from November 12, 2026.', a?.devices, 'No visitors yet.'],
];
const links = taggedLinks(site.origin);
---

<Base title="Admin" noindex>
  <h1 class="page-title">Admin</h1>
  <AdminNav humans={humans} />

  <div class="stack" style="margin-top:28px;gap:44px">
    {
      !a ? (
        <p class="empty">The numbers are unavailable right now.</p>
      ) : (
        <>
          <section class="stack" id="overview">
            <p class="toggle">
              {humans ? (
                <>
                  <strong>Leaving out {n(marked)} possibly automated visits.</strong>
                  <a class="link" href="/admin">Count everyone</a>
                </>
              ) : (
                <>
                  <strong>Counting everyone.</strong>
                  {marked > 0 && <a class="link" href="/admin?humans=1">Leave out the {n(marked)} that look automated</a>}
                </>
              )}
            </p>
            <dl class="tiles">
              {periods.map(([key, label]) => {
                const t = a.totals[key];
                return (
                  <div class="card">
                    <dt>{label}</dt>
                    <dd class="num">{n(t.visitors)} <small>visitors</small></dd>
                    {key === 'today' && delta && <dd class:list={['delta', delta.up ? 'up' : 'down']}>{delta.text}</dd>}
                    <dd class="num sub">{n(t.views)} page views</dd>
                    <dd class="num sub">{n(t.converted)} signed up for something ({percent(t.converted, t.visitors)})</dd>
                    {!humans && t.automated > 0 && <dd class="num sub">{n(t.automated)} look automated</dd>}
                  </div>
                );
              })}
            </dl>
            <p class="admin-note">
              <strong>How these are counted.</strong> A visitor is one browser on one network on one day, so over several days the
              same person counts once per day. Only a real browser opening a public page on the live site is counted: crawlers,
              scripts, link previews, uptime checks, pages fetched ahead of time and your own visits while signed in are not. That
              makes these numbers lower than the raw request count your host shows, not higher: in one 53-minute window on November
              12 the host logged 40 page requests and 29 were counted here. Some programs pretend to be browsers and get through;
              those are marked "possibly automated" on the{' '}
              <a class="link" href="/admin/visitors">visitors page</a>, shown and never deleted, and the link above leaves them
              out of every number here. "Signed up for something" is a visit that signed in, joined the list, joined as a builder,
              pledged, applied to the panel, offered to organize or sent a sponsor inquiry. Days and times are UTC.
            </p>

            <div class="tables">
              <figure class="card chart">
                <figcaption>Visitors per hour, last 48 hours (busiest hour: {n(hourPeak)})</figcaption>
                <svg class="tall" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Visitors per hour for the last 48 hours. The busiest hour had ${n(hourPeak)}.`} preserveAspectRatio="none">
                  {hourBars.map((b, i) => (
                    <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="1.5">
                      <title>{when(a.hourly[i].at)} UTC: {n(a.hourly[i].visitors)} visitors, {n(a.hourly[i].views)} views</title>
                    </rect>
                  ))}
                </svg>
                <p class="chart-x"><span>{when(a.hourly[0]?.at ?? '')}</span><span>{when(a.hourly[a.hourly.length - 1]?.at ?? '')} UTC</span></p>
              </figure>
              <figure class="card chart">
                <figcaption>Visitors per day, last 30 days (busiest day: {n(dayPeak)})</figcaption>
                <svg class="tall" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Visitors per day for the last 30 days. The busiest day had ${n(dayPeak)}.`} preserveAspectRatio="none">
                  {dayBars.map((b, i) => (
                    <rect class="alt" x={b.x} y={b.y} width={b.w} height={b.h} rx="2">
                      <title>{a.daily[i].day}: {n(a.daily[i].visitors)} visitors, {n(a.daily[i].views)} views, {n(a.daily[i].converted)} signed up</title>
                    </rect>
                  ))}
                </svg>
                <p class="chart-x"><span>{a.daily[0]?.day}</span><span>{a.daily[a.daily.length - 1]?.day}</span></p>
              </figure>
            </div>

            <div class="card">
              <p class="h3">What people did</p>
              <div class="scroll-x">
                <table class="data">
                  <thead><tr><th scope="col">&nbsp;</th>{periods.map(([, label]) => <th scope="col">{label}</th>)}</tr></thead>
                  <tbody>
                    {EVENT_KINDS.map((k) => (
                      <tr>
                        <th scope="row">{EVENT_LABELS[k]}</th>
                        {periods.map(([key]) => {
                          const v = a.totals[key].events[k] ?? 0;
                          return <td class:list={['num', !v && 'zero']}>{n(v)}</td>;
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="muted small" style="margin-top:10px">
                Every action is counted here, including your own. Who did each one is on the{' '}
                <a class="link" href="/admin/people">people page</a>.
              </p>
            </div>
          </section>

          <section class="stack" id="sources">
            <p class="h2">Where visitors came from</p>
            <p class="admin-note">
              Last 30 days, by the first page view of each visit. A tag on the link wins over the referring site. "Direct or
              unknown" means the visit arrived with neither: typed in, opened from a message, or sent from an app that hides
              where it came from, which X, most mail apps and most phone apps do.
            </p>
            <div class="card scroll-x">
              <table class="data wide">
                <thead>
                  <tr>
                    <th scope="col">Source</th><th scope="col">Visitors</th><th scope="col">Views</th><th scope="col">Signed up</th><th scope="col">Rate</th>
                    <th scope="col">Sign-ins</th><th scope="col">Email list</th><th scope="col">Builders</th><th scope="col">Pledges</th><th scope="col">Panel, organize, sponsor</th>
                  </tr>
                </thead>
                <tbody>
                  {a.sources.map((s) => (
                    <tr>
                      <th scope="row">
                        {sourceName(s.label)}
                        {(s.hosts.length > 0 || s.campaigns.length > 0) && (
                          <span class="sub">{[s.hosts.join(', '), s.campaigns.length ? `campaigns: ${s.campaigns.join(', ')}` : ''].filter(Boolean).join('; ')}</span>
                        )}
                      </th>
                      <td class="num">{n(s.visitors)}</td>
                      <td class="num">{n(s.views)}</td>
                      <td class="num">{n(s.converted)}</td>
                      <td class="num">{percent(s.converted, s.visitors)}</td>
                      <td class="num">{n(did(s.events, 'signed_in'))}</td>
                      <td class="num">{n(did(s.events, 'list_joined'))}</td>
                      <td class="num">{n(did(s.events, 'joined_builder'))}</td>
                      <td class="num">{n(did(s.events, 'pledged'))}</td>
                      <td class="num">{n(did(s.events, 'panel_applied', 'organize_offered', 'sponsor_inquiry'))}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="card stack">
              <p class="h3">Tag every link you post</p>
              <p class="muted">
                Add <code>?ref=</code> and a short word to the end of the link. Whoever follows it shows up under that word here,
                along with what they went on to do, even when the app hides where they came from. Use one word per place, and
                make up new ones freely (letters, numbers, dots and dashes): <code>?ref=x-launch-thread</code>,{' '}
                <code>?ref=newsletter-nov</code>. The longer <code>utm_source</code>, <code>utm_medium</code> and{' '}
                <code>utm_campaign</code> work too.
              </p>
              <ul class="tag-links">
                {links.map((l) => <li><strong>{l.where}:</strong> <code>{l.link}</code></li>)}
              </ul>
            </div>
            <p class="admin-note">
              Sign-ups from before November 12, 2026 have no source: nothing tied an action to a visit until then. They are on
              the people page, marked as such.
            </p>
          </section>

          <section class="stack" id="pages">
            <p class="h2">Pages, countries and devices</p>
            <div class="tables">
              {tables.map(([title, note, rows, empty]) => (
                <div class="card">
                  <p class="h3">{title}</p>
                  <p class="muted small" style="margin-bottom:8px">{note}</p>
                  {rows && rows.length ? (
                    <table class="data">
                      <thead><tr><th scope="col">&nbsp;</th><th scope="col">Visitors</th><th scope="col">Views</th>{rows[0].converted !== undefined && <th scope="col">Signed up</th>}</tr></thead>
                      <tbody>
                        {rows.map((r) => (
                          <tr><th scope="row">{r.label}</th><td class="num">{n(r.visitors)}</td><td class="num">{n(r.views)}</td>{r.converted !== undefined && <td class="num">{n(r.converted)}</td>}</tr>
                        ))}
                      </tbody>
                    </table>
                  ) : (
                    <p class="muted">{empty}</p>
                  )}
                </div>
              ))}
            </div>
          </section>
        </>
      )
    }
  </div>
</Base>
