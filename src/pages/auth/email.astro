---
import Base from '../../layouts/Base.astro';
import { safeNext } from '../../lib/respond';

const next = safeNext(Astro.url.searchParams.get('next'), '/');
const sent = Astro.url.searchParams.get('sent') === '1';
---

<Base title="Sign in with your email" description="Sign in to Antipaywall with a link sent to your email. No GitHub account needed." noindex>
  <h1 class="page-title">Sign in with your email</h1>
  <p class="lede">
    No GitHub or GitLab account? Get a link by email instead. You can back what you want, say what you would pay, test early builds
    and post what's missing. Joining the hackathon as a builder still needs GitHub or GitLab.
  </p>
  <div class="cols">
    <form class="card stack" method="post" action="/api/auth/email">
      <input type="hidden" name="next" value={next} />
      <div class="field">
        <label for="email">Your email</label>
        <input class="input" id="email" name="email" type="email" required autocomplete="email" maxlength="254" />
      </div>
      <button class="key key-big" type="submit">{sent ? 'Send another link' : 'Email me a sign-in link'}</button>
      <p class="muted small">
        We use the address only to sign you in. It isn't shown on the site and isn't added to any list.{' '}
        <a class="link" href="/privacy">What we record</a>
      </p>
    </form>
    <div class="stack">
      <p class="h2">Have GitHub?</p>
      <p>Sign in with it instead to join as a builder, claim gaps and follow projects.</p>
      <a class="key key-milk" href={`/auth/signin?next=${encodeURIComponent(next)}`} style="justify-self:start">Sign in with GitHub</a>
    </div>
  </div>
</Base>
