---
import Base from '../layouts/Base.astro';
import Sponsors from '../components/Sponsors.astro';
import { attempt, listSponsors } from '../lib/db';
import { bountyRules, money, site } from '../config/site';
const sponsors = await attempt(() => listSponsors());
const [t1, t2, t3] = site.sponsorTiersUsd;
const f = (n: number) => '$' + n.toLocaleString('en-US');
---

<Base title="Sponsor" description="Sponsor the prize pool. Your money goes into the same public pool as everyone else's.">
  <h1 class="page-title">Sponsor the builders, not the organizer.</h1>
  <p class="lede">
    Companies sponsor by putting money into the same public pool as everyone else, or by putting
    up a bounty for one specific thing they want built. You get visibility and goodwill. You
    never get a say in who wins the main prizes.
  </p>
  <div class="cols">
    <div class="stack">
      <div class="card card-paint p3 stack">
        <p class="h2">What sponsors get</p>
        <ul style="margin:0;padding-left:1.2em;display:grid;gap:6px">
          <li>Your logo on the homepage and here, with the amount and whether it is pledged or paid</li>
          <li>Logo size steps up at {f(t1)}, {f(t2)} and {f(t3)}</li>
          <li>A thank-you post and a mention in the final results</li>
        </ul>
      </div>
      <div class="card card-paint p6 stack">
        <p class="h2">What sponsors don't get</p>
        <ul style="margin:0;padding-left:1.2em;display:grid;gap:6px">
          <li>Votes, or any say in who wins the main prizes</li>
          <li>Changes to the rules</li>
          <li>Builders' contact details</li>
          <li>A requirement that anyone uses your product</li>
        </ul>
      </div>
    </div>
    <div class="stack">
      <p class="h2">How it works</p>
      <ol style="margin:0;padding-left:1.2em;display:grid;gap:10px">
        <li>Pick an amount for the pool.</li>
        <li>{site.collective.pending ? 'Pledge it now. You pay once the pool opens.' : 'Pay by card or invoice on Open Collective.'}</li>
        <li>{site.collective.pending ? "Your pledge is listed on this site under your company's name once a person has checked it. When you pay, the payment appears on the pool holder's public ledger." : "It appears on the public ledger under your company's name."}</li>
      </ol>
      <p class="muted">
        {money.full}
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a class="key key-big key-tomato" href="#inquiry">Ask about sponsoring</a>
        <a class="key key-big key-milk" href="/fund?as=company">Pledge as a company</a>
      </div>
    </div>
  </div>

  <div class="stack" style="margin-top:clamp(40px,6vw,80px);gap:0">
    <p class="h2">{sponsors && sponsors.length ? 'Sponsors so far' : 'Be the first sponsor'}</p>
    <Sponsors sponsors={sponsors} />
  </div>

  <div class="cols" id="inquiry" style="scroll-margin-top:24px">
    <div class="stack">
      <p class="h2">Talk to a person first</p>
      <p>
        Tell us roughly what you have in mind and the organizer will reply himself, by email.
        Nothing here commits you to anything, and nothing is published until you say so.
      </p>
      <p class="muted">
        What you send is stored where only the organizer can read it. It is not shown on the
        site, and your address is not added to the email list.
      </p>
    </div>
    <form class="card stack" method="post" action="/api/sponsor-inquiry">
      <p class="h2">Sponsor inquiry</p>
      <div class="field">
        <label for="sp-company">Company</label>
        <input class="input" id="sp-company" name="company" required maxlength="120" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="sp-contact">Your name</label>
        <input class="input" id="sp-contact" name="contact" required maxlength="120" autocomplete="name" />
      </div>
      <div class="field">
        <label for="sp-email">Work email</label>
        <input class="input" id="sp-email" name="email" type="email" required maxlength="254" autocomplete="email" />
      </div>
      <div class="field">
        <label for="sp-amount">Rough amount in dollars <span class="muted">(optional)</span></label>
        <input class="input" id="sp-amount" name="amount" inputmode="numeric" maxlength="12" autocomplete="off" />
      </div>
      <div class="field">
        <label for="sp-kind">What for</label>
        <select class="input" id="sp-kind" name="kind">
          <option value="unsure">Not sure yet</option>
          <option value="pool">The main prize pool</option>
          <option value="bounty">A bounty for something specific</option>
        </select>
      </div>
      <div class="field">
        <label for="sp-message">Message <span class="muted">(optional)</span></label>
        <textarea class="input" id="sp-message" name="message" maxlength="1000"></textarea>
      </div>
      {/* Not for people. A script that fills in every field gives itself away here. */}
      <div class="trap" aria-hidden="true">
        <label for="sp-website">Leave this empty</label>
        <input id="sp-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <button class="key key-big key-tomato" type="submit">Send to the organizer</button>
      <p class="muted small">By sending this you agree to the <a class="link" href="/terms">terms</a>.</p>
    </form>
  </div>

  <div class="prose">
    <h2>Bounties</h2>
    <p>
      A bounty is money for the best entry that does one specific thing. It is separate from the
      main prizes and is won on top of them. Bounties will be listed on this site once the first
      sponsor commits to one. This is how each one is decided:
    </p>
    <ol>
      {bountyRules.map((r) => <li>{r}</li>)}
    </ol>
  </div>
</Base>
