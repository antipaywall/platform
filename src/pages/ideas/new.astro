---
import SignIn from '../../components/SignIn.astro';
import Base from '../../layouts/Base.astro';
import '../../styles/platform.css';
import { adminClient } from '../../lib/supabase';

const person = Astro.locals.person;
const signedIn = Boolean(person);
// Coming from a search or a paid product's page, the form starts filled in.
const startTitle = (Astro.url.searchParams.get('title') ?? '').slice(0, 80);
const productSlug = (Astro.url.searchParams.get('product') ?? '').toLowerCase();
let startProduct: { slug: string; name: string } | null = null;
if (/^[a-z0-9-]{1,60}$/.test(productSlug)) {
  const { data } = (await adminClient()?.from('products').select('slug, name').eq('slug', productSlug).maybeSingle()) ?? { data: null };
  startProduct = data ?? null;
}
---

<Base title="Post something you want" description="Name something that should be free. We show you what already exists so you can say what is missing.">
  <h1 class="page-title">Name something that should be free.</h1>
  <p class="lede">
    As you type, we look for open-source projects that already do it. If one of them solves your
    problem, great. If not, say what is missing: that gap is the opportunity.
  </p>
  <div class="cols">
    <form id="idea-form" class="card stack" method="post" action="/api/ideas" data-idea-form data-signed-in={signedIn ? "1" : undefined}>
      <div class="field">
        <label for="title">The idea</label>
        <input class="input" id="title" name="title" required minlength="3" maxlength="80" placeholder="A brand design skill that makes good logos" autocomplete="off" value={startTitle} />
      </div>
      <div class="field">
        <label for="pitch">What it should do <span class="muted">(optional)</span></label>
        <textarea class="input" id="pitch" name="pitch" maxlength="280"></textarea>
      </div>
      <div class="field">
        <label for="missing">What the existing options are missing</label>
        <textarea class="input" id="missing" name="missing" maxlength="600"></textarea>
        <span class="help">Needed if similar projects exist. We search again when you post, and that list is what gets saved. Be specific: too hard to set up, missing a feature, abandoned.</span>
      </div>
      <fieldset class="stack" data-products style="border:0;padding:0;margin:0;gap:8px" hidden={!startProduct}>
        <legend class="muted small" style="font-weight:700;padding:0">It replaces</legend>
        <div class="pf-chips" data-product-list>
          {startProduct && (
            <label class="chip"><input type="checkbox" name="products" value={startProduct.slug} checked /> {startProduct.name}</label>
          )}
        </div>
      </fieldset>
      {
        signedIn ? (
          <button class="key key-big key-tomato" type="submit">Post this idea</button>
          <p class="muted small">By sending this you agree to the <a class="link" href="/terms">terms</a>.</p>
        ) : (
          <>
            <SignIn next="/ideas/new" label="Sign in with GitHub to post" />
          </>
        )
      }
    </form>

    <div class="stack" aria-live="polite">
      <div class="stack" data-wanted hidden>
        <p class="h2">Is it one of these?</p>
        <p class="muted">Someone may already want the same thing. Backing theirs puts everyone's support in one place, which is what builders look at.</p>
        <ul class="pf-list" data-wanted-list></ul>
      </div>
      <p class="h2" data-found-title>Already out there</p>
      <p class="muted" data-found-note>Start typing the idea. We look through the {signedIn ? 'projects we follow and all of GitHub' : 'open-source projects we follow'} for anything close.</p>
      <ul class="in-found" data-found></ul>
      {!signedIn && <p class="muted small" data-found-more hidden>Sign in and we also search all of GitHub as you type.</p>}
    </div>
  </div>
</Base>

<script>
  type Hit = { fullName: string; url: string; description: string | null; stars: number; license?: string | null; tracked?: boolean };
  type Match = { products: { slug: string; name: string }[]; gaps: { slug: string; title: string }[]; projects: { fullName: string; description: string | null; stars: number }[] };
  const form = document.querySelector<HTMLFormElement>('[data-idea-form]');
  if (form) {
    const signedIn = Boolean(form.dataset.signedIn);
    const title = form.querySelector<HTMLInputElement>('#title')!;
    const pitch = form.querySelector<HTMLTextAreaElement>('#pitch')!;
    const list = document.querySelector<HTMLElement>('[data-found]')!;
    const note = document.querySelector<HTMLElement>('[data-found-note]')!;
    const head = document.querySelector<HTMLElement>('[data-found-title]')!;
    const more = document.querySelector<HTMLElement>('[data-found-more]');
    const stars = (n: number) => (n >= 1000 ? (n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, '') + 'k' : String(n));
    let timer = 0;
    let latest = '';
    // Two sources fill one list: the projects we follow (at once), then all of GitHub (signed in).
    let tracked: Hit[] = [];
    let github: Hit[] | null = null;
    let githubDown = false;

    const render = () => {
      const seen = new Set<string>();
      const hits = [...tracked, ...(github ?? [])].filter((h) => !seen.has(h.fullName.toLowerCase()) && seen.add(h.fullName.toLowerCase())).slice(0, 8);
      list.replaceChildren();
      if (more) more.hidden = false;
      if (!hits.length) {
        const waiting = signedIn && github === null && !githubDown;
        head.textContent = waiting ? 'Looking…' : 'Nothing like it yet';
        note.textContent = waiting ? 'Searching GitHub.' : githubDown ? 'Nothing among the projects we follow, and GitHub search is busy right now. You can still post the idea.' : 'We found no open-source project that does this. Wide open.';
        return;
      }
      head.textContent = "Are you sure these don't solve it?";
      note.textContent = 'The closest open-source projects we could find. If none fits, say what is missing: that is the part worth building. Builders can also start from one of these.';
      for (const h of hits) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = h.tracked ? `/projects/${h.fullName}` : h.url;
        a.target = '_blank';
        a.rel = 'noopener';
        const img = document.createElement('img');
        img.src = `https://github.com/${h.fullName.split('/')[0]}.png?size=72`;
        img.alt = '';
        img.width = 36;
        img.height = 36;
        img.loading = 'lazy';
        const t = document.createElement('span');
        t.className = 'in-t';
        const b = document.createElement('b');
        b.textContent = h.fullName;
        const d = document.createElement('span');
        d.textContent = h.description || 'No description';
        t.append(b, d);
        const s = document.createElement('span');
        s.className = 'in-s';
        s.textContent = `★ ${stars(h.stars)}${h.license ? ` · ${h.license}` : ''}`;
        a.append(img, t, s);
        li.append(a);
        list.append(li);
      }
    };

    const wanted = document.querySelector<HTMLElement>('[data-wanted]')!;
    const wantedList = document.querySelector<HTMLElement>('[data-wanted-list]')!;
    const productBox = document.querySelector<HTMLElement>('[data-products]')!;
    const productList = document.querySelector<HTMLElement>('[data-product-list]')!;
    const showMatches = (m: Match) => {
      wantedList.replaceChildren();
      for (const g of m.gaps.slice(0, 4)) {
        const li = document.createElement('li');
        li.className = 'pf-row-flat';
        const div = document.createElement('div');
        const a = document.createElement('a');
        a.href = `/ideas/${g.slug}`;
        a.textContent = g.title;
        div.append(a);
        const back = document.createElement('a');
        back.className = 'key key-sm key-mint';
        back.href = `/ideas/${g.slug}`;
        back.textContent = 'Back this one instead';
        li.append(div, back);
        wantedList.append(li);
      }
      wanted.hidden = m.gaps.length === 0;
      const kept = new Set([...productList.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => i.value));
      for (const label of [...productList.children]) {
        const input = label.querySelector('input');
        if (input && !input.checked) label.remove();
      }
      for (const p of m.products.slice(0, 4)) {
        if (kept.has(p.slug)) continue;
        const label = document.createElement('label');
        label.className = 'chip';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.name = 'products';
        input.value = p.slug;
        label.append(input, ` ${p.name}`);
        productList.append(label);
      }
      productBox.hidden = productList.children.length === 0;
    };

    const search = () => {
      clearTimeout(timer);
      // The idea and what it should do together say more than the title alone.
      const q = `${title.value} ${pitch.value}`.replace(/\s+/g, ' ').trim().slice(0, 120);
      if (title.value.trim().length < 3) return;
      timer = window.setTimeout(async () => {
        latest = q;
        tracked = [];
        github = null;
        githubDown = false;
        fetch(`/api/match?q=${encodeURIComponent(q)}`)
          .then((r) => r.json())
          .then((m: Match) => {
            if (latest !== q) return;
            showMatches(m);
            tracked = (m.projects ?? []).slice(0, 5).map((p) => ({ ...p, url: `https://github.com/${p.fullName}`, tracked: true }));
            render();
          })
          .catch(() => undefined);
        if (!signedIn) return;
        try {
          const res = await fetch(`/api/repo-search?q=${encodeURIComponent(q)}`);
          const body = await res.json();
          if (latest !== q) return;
          github = body.hits ?? [];
          githubDown = Boolean(body.unavailable);
        } catch {
          if (latest !== q) return;
          github = [];
          githubDown = true;
        }
        render();
      }, 800);
    };
    title.addEventListener('input', search);
    pitch.addEventListener('input', search);
    if (title.value.trim().length >= 3) search();
  }
</script>

<style is:global>
  .in-found { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .in-found a { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; background: var(--card); box-shadow: 0 0 0 1px var(--line); text-decoration: none; color: var(--ink); }
  .in-found a:hover { box-shadow: 0 0 0 1.5px var(--ink); }
  .in-found img { border-radius: 10px; background: var(--milk-2); }
  .in-t { display: grid; min-width: 0; gap: 2px; }
  .in-t b { font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .in-t span { font-size: 0.875rem; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .in-s { font-size: 0.8125rem; font-weight: 700; color: var(--ink-2); white-space: nowrap; }
</style>
