---
import Base from '../../layouts/Base.astro';
import Heart from '../../components/Heart.astro';
import { DataUnavailableError, getIdea, heartedBy, type Idea } from '../../lib/db';
import { postedBy } from '../../lib/ideas';
import { visitorId } from '../../lib/visitor';

let idea: Idea | null;
let hearted = false;
try {
  idea = await getIdea(String(Astro.params.slug));
  if (idea) hearted = (await heartedBy(visitorId(Astro.cookies), [idea.id])).has(idea.id);
} catch (e) {
  if (!(e instanceof DataUnavailableError)) throw e;
  // The database can't be read: say so, rather than claim the idea doesn't exist.
  return new Response('Ideas are unavailable right now. Try again in a minute.', { status: 503, headers: { 'retry-after': '60' } });
}
if (!idea) return new Response(null, { status: 404 });
const paras = (t: string) => t.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
const writeup: [string, string][] = [
  ['The problem', idea.problem],
  ['What to build', idea.build],
  ['A strong entry', idea.strong],
];
let sourceHost = '';
try {
  if (idea.sourceUrl) sourceHost = new URL(idea.sourceUrl).hostname.replace(/^www\./, '');
} catch {}
const stars = (n: number) => (n >= 1000 ? (n / 1000).toFixed(n >= 10000 ? 0 : 1) + 'k' : String(n));
---

<Base title={idea.title} description={idea.pitch || `An idea for something that should be free: ${idea.title}.`}>
  <p class="muted small"><a class="link" href="/ideas">All ideas</a></p>
  <h1 class="page-title" style="margin-top:12px">{idea.title}</h1>
  {idea.pitch && <p class="lede">{idea.pitch}</p>}

  <div class="idea-actions">
    <Heart slug={idea.slug} hearts={idea.hearts} hearted={hearted} big />
    <span class="muted">{hearted ? 'You want this.' : 'Want this to exist? Give it a heart. No account needed.'}</span>
  </div>
  <p class="muted small" style="margin-top:14px">Posted by {postedBy(idea)}</p>

  <div class="cols">
    <div class="stack" style="gap:28px">
      {
        writeup.filter(([, text]) => text).map(([heading, text]) => (
          <div class="stack" style="gap:8px">
            <p class="h2">{heading}</p>
            {paras(text).map((p) => <p>{p}</p>)}
          </div>
        ))
      }
      {
        idea.sourceUrl && sourceHost && (
          <p class="muted small">
            Source for the claims above:{' '}
            <a class="link" href={idea.sourceUrl} rel="noopener nofollow">{sourceHost}</a>
          </p>
        )
      }
      {
        idea.missing && (
          <div class="stack" style="gap:8px">
            <p class="h2">What is missing today</p>
            <p>{idea.missing}</p>
          </div>
        )
      }
      {
        idea.existing_repos.length > 0 && (
          <div class="stack" style="gap:10px">
            <p class="h2">Already out there</p>
            <ul class="repos">
              {idea.existing_repos.map((r) => (
                <li>
                  <a href={r.url} rel="noopener">{r.fullName}</a>
                  <span class="stars">★ {stars(r.stars)}</span>
                </li>
              ))}
            </ul>
            <p class="muted small">Found by a GitHub search when this idea was posted. We have not reviewed them. Builders may fork one of these or start fresh.</p>
          </div>
        )
      }
    </div>
    <div class="card stack">
      <p class="h2">Going to build it?</p>
      <p>
        Ideas show what people want. They carry no money and no prize of their own: an entry that
        builds one competes for the main prizes like any other.
      </p>
      <a class="key key-big" href="/join/build" style="justify-self:start">Join as a builder</a>
    </div>
  </div>
</Base>
