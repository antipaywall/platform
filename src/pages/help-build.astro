---
// How to help build Antipaywall itself: what we're working on, what we need, and every way in,
// from thirty seconds to a weekend. The platform's code and the ideas are both public.
import Platform from '../layouts/Platform.astro';
import { site } from '../config/site';

const now = [
  { title: 'The platform release', text: 'Free alternatives for every paid tool we track, gaps that rank themselves, builder profiles and the feed, all in one place.', state: 'Building now' },
  { title: 'Season 1 of the hackathon', text: `Starts once ${site.launch.buildersNeeded} builders have joined. The most wanted gaps become the briefs.`, state: 'Gathering builders' },
  { title: 'Open Source Ready', text: 'A free guide and an agent skill for getting any project ready to share.', state: 'Ready to launch' },
  { title: 'Antipaywall for coding agents', text: 'Ask your agent whether a free version exists, look up a tool, or post what is missing, without leaving your editor.', state: 'Building now' },
];

const ways = [
  { time: '30 seconds', title: 'Tell us what you pay for', text: 'Every tool you add fills in the map and shows where the gaps are.', href: '/welcome', cta: 'Add your tools', paint: 'p3' },
  { time: '1 minute', title: 'Say "me too" on a gap', text: 'The most wanted gaps become the next season\'s briefs.', href: '/ideas', cta: 'See what people want', paint: 'p2' },
  { time: '10 minutes', title: 'Make your first contribution', text: 'Add an idea to the public ideas repository as a pull request, guided step by step.', href: '/first-contribution', cta: 'Start the walk-through', paint: 'p4' },
  { time: 'An hour', title: 'Improve an idea', text: 'Know how something should work? Suggest an improvement to an idea; it goes to whoever started it.', href: '/ideas', cta: 'Pick an idea', paint: 'p5' },
  { time: 'A few hours', title: 'Fix something on the site', text: 'The platform is open source under the MIT license. Pick a good first issue and send a pull request.', href: `${site.repo}/issues?q=is%3Aopen+label%3A%22good+first+issue%22`, cta: 'Good first issues', paint: 'p6' },
  { time: 'A weekend', title: 'Build a gap', text: 'Join the hackathon, or start the free version of something people want right now.', href: '/hackathon', cta: 'The hackathon', paint: 'p1' },
];
---

<Platform title="Help build Antipaywall" description="Antipaywall is built by the people who use it. What we're working on, and every way to help, from thirty seconds to a weekend.">
  <section class="wrap pf-hero">
    <div class="pf-hero-main">
      <h1 class="pf-title">Help build Antipaywall</h1>
      <p class="lede hb-lede">
        Antipaywall only works if it belongs to the people who use it. The code is public, the ideas are public, and every
        way of helping is listed here, smallest first.
      </p>
    </div>
  </section>

  <section class="wrap pf-section">
    <h2 class="pf-h2">Ways to help</h2>
    <div class="hb-ways">
      {ways.map((w) => (
        <a class={`pf-brick ${w.paint}`} href={w.href} rel={w.href.startsWith('http') ? 'noopener' : undefined}>
          <small>{w.time}</small>
          <b>{w.title}</b>
          <span>{w.text}</span>
          <small class="hb-cta">{w.cta}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="pf-band">
    <div class="wrap pf-section">
      <h2 class="pf-h2">What we're working on</h2>
      <ul class="hb-now">
        {now.map((n) => (
          <li>
            <span class="pf-tag">{n.state}</span>
            <b>{n.title}</b>
            <span class="muted">{n.text}</span>
          </li>
        ))}
      </ul>
      <p class="muted">Decisions and plans happen in public, in the <a class="link" href={`${site.repo}/issues`} rel="noopener">issues</a> and <a class="link" href={`${site.repo}/discussions`} rel="noopener">discussions</a> on GitHub.</p>
    </div>
  </section>

  <section class="wrap pf-section">
    <h2 class="pf-h3">Working on the code</h2>
    <p>
      The platform is an Astro site with a Postgres database. You can run all of it on your own computer with sample data.
      Start with the contributing guide, then pick an issue labelled <code>good first issue</code>. Working with a coding agent
      is welcome; please read and test what it writes before you send it.
    </p>
    <div class="pf-chips">
      <a class="key key-sm key-milk" href={`${site.repo}/blob/main/CONTRIBUTING.md`} rel="noopener">Contributing guide</a>
      <a class="key key-sm key-milk" href={`${site.repo}/blob/main/docs/run-locally.md`} rel="noopener">Run it locally</a>
      <a class="key key-sm key-milk" href={site.repo} rel="noopener">The code</a>
    </div>
  </section>
</Platform>
