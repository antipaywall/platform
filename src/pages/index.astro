---
import '../styles/home.css';
import Platform from '../layouts/Platform.astro';
import BuilderTile from '../components/BuilderTile.astro';
import Heart from '../components/Heart.astro';
import Wall from '../components/Wall.astro';
import InstantSearch from '../components/pf/InstantSearch.astro';
import { site } from '../config/site';
import { attempt, getStats, heartedBy, listBuilders, usd } from '../lib/db';
import { shortCount } from '../lib/format';
import { demandFor } from '../lib/gaps';
import { findOpenGaps, listProducts, priceLabel, type ProductSummary } from '../lib/products';
import { tileBadges } from '../lib/social';
import { adminClient } from '../lib/supabase';
import { listTopics } from '../lib/topics';
import ProjectCard from '../components/pf/ProjectCard.astro';
import { visitorId } from '../lib/visitor';

const db = adminClient();
const need = site.launch.buildersNeeded;
const [stats, platform, products, topics, builders] = await Promise.all([
  attempt(getStats),
  db ? db.rpc('site_platform_stats').then((r) => (r.error ? null : (r.data as { products: number; projects: number; gaps: number; signals: number })), () => null) : Promise.resolve(null),
  db ? listProducts(db).catch(() => [] as ProductSummary[]) : Promise.resolve([] as ProductSummary[]),
  db ? listTopics(db).catch(() => []) : Promise.resolve([]),
  attempt(() => listBuilders(11)),
]);
const builderBadges = (builders && (await attempt(() => tileBadges(builders.map((b) => b.id))))) || new Map();
// The paid products people care about most first, then the ones with the most free options.
const ranked = [...products].sort((a, b) => b.signals - a.signals || b.freeOptions - a.freeOptions);
// Gaps the platform finds itself: paid tools with no free alternative many people rely on.
const openGaps = findOpenGaps(products);
// The tools most people know from their own card statement, in this order; anything the catalog
// doesn't have yet is skipped, and the list is topped up from the rest.
const EVERYDAY = ['calendly', 'loom', 'notion', 'formspree', 'typeform', 'semrush', 'mailchimp', 'zapier', 'slack', 'dropbox', 'photoshop', 'docusign', 'linktree', 'zoom', 'trello', 'lastpass', 'grammarly'];
const bySlug = new Map(products.map((p) => [p.slug, p]));
const everyday = EVERYDAY.map((s) => bySlug.get(s)).filter((p): p is ProductSummary => Boolean(p) && p!.freeOptions > 0);
const featured = [...everyday, ...ranked.filter((p) => !EVERYDAY.includes(p.slug) && p.category !== 'AI tools' && p.category !== 'Developer tools')].slice(0, 12);
// The best-known free alternative to each, to name on its brick.
const leadFree = new Map<string, string>();
if (db && featured.length) {
  const { data } = await db.from('project_products').select('source, products!inner(slug), projects!inner(name, stars, listed)').in('products.slug', featured.map((p) => p.slug)).eq('source', 'catalog').eq('projects.listed', true).limit(200);
  for (const r of ((data ?? []) as any[]).sort((a, b) => b.projects.stars - a.projects.stars)) if (!leadFree.has(r.products.slug)) leadFree.set(r.products.slug, r.projects.name);
}


// Every gap, with its demand: the wall's real bricks and "Wanted, but nobody has built it".
let wanted: { id: string; slug: string; title: string; want: number; pay: number; status: string; hearted: boolean }[] = [];
if (db) {
  const { data } = await db.from('ideas').select('id, slug, title, build_status').eq('status', 'listed').is('merged_into', null).limit(500);
  const demand = await demandFor(db, (data ?? []).map((i) => i.id)).catch(() => new Map());
  const all = (data ?? [])
    .map((i) => ({ id: i.id, slug: i.slug, title: i.title, status: i.build_status, want: demand.get(i.id)?.want ?? 0, pay: demand.get(i.id)?.pay ?? 0 }))
    .sort((a, b) => b.want - a.want || b.pay - a.pay);
  const mine = await attempt(() => heartedBy(visitorId(Astro.cookies), all.slice(0, 12).map((g) => g.id)));
  wanted = all.map((g) => ({ ...g, hearted: mine?.has(g.id) ?? false }));
}
const nobody = wanted.filter((g) => g.status === 'wanted').slice(0, 6);
// The wall: real paid products, and the most wanted ideas nearest the headline.
const wallProducts = ranked.slice(0, 48).map((p) => ({ slug: p.slug, name: p.name, free: p.freeOptions }));
const wallIdeas = wanted.slice(0, 10).map((g) => ({ slug: g.slug, title: g.title, hearts: g.want }));

// Open issues maintainers want help with, across the projects that replace paid products.
let help: { title: string; url: string; repo: string; label: string }[] = [];
if (db) {
  const { data } = await db
    .from('help_issues')
    .select('title, url, labels, updated_at, projects!inner(full_name, listed, stars)')
    .eq('projects.listed', true)
    .gte('projects.stars', 2000)
    .order('updated_at', { ascending: false })
    .limit(40);
  // Titles written mostly in the Latin alphabet, one per project, so the list reads as one list.
  const latin = (t: string) => { const letters = t.match(/\p{L}/gu) ?? []; return letters.length > 0 && letters.filter((c) => /[A-Za-z]/.test(c)).length / letters.length > 0.9; };
  const seenRepo = new Set<string>();
  help = ((data ?? []) as any[]).filter((i) => latin(i.title) && !seenRepo.has(i.projects.full_name) && seenRepo.add(i.projects.full_name)).slice(0, 6).map((i) => ({ title: i.title, url: i.url, repo: i.projects.full_name, label: (i.labels ?? []).find((l: string) => /help|first/i.test(l)) ?? 'help wanted' }));
}
// Projects and ideas whose builders are looking for someone to carry them on.
let handoffs: { href: string; title: string; by: string }[] = [];
if (db) {
  const { data } = await db.from('adoptions').select('subject_kind, subject_id, people:offered_by(username, handle)').eq('status', 'open').order('created_at', { ascending: false }).limit(6);
  const rows = (data ?? []) as any[];
  const projectIds = rows.filter((r) => r.subject_kind === 'project').map((r) => r.subject_id);
  const gapIds = rows.filter((r) => r.subject_kind === 'gap').map((r) => r.subject_id);
  const [projects, gaps] = await Promise.all([
    projectIds.length ? db.from('projects').select('id, full_name').in('id', projectIds) : Promise.resolve({ data: [] }),
    gapIds.length ? db.from('ideas').select('id, slug, title').in('id', gapIds) : Promise.resolve({ data: [] }),
  ]);
  const pBy = new Map(((projects as any).data ?? []).map((p: any) => [p.id, p]));
  const gBy = new Map(((gaps as any).data ?? []).map((g: any) => [g.id, g]));
  handoffs = rows.flatMap((r) => {
    const by = r.people?.username ?? r.people?.handle ?? 'someone';
    const p: any = r.subject_kind === 'project' ? pBy.get(r.subject_id) : null;
    const g: any = r.subject_kind === 'gap' ? gBy.get(r.subject_id) : null;
    if (p) return [{ href: `/projects/${p.full_name}#adopt`, title: p.full_name, by }];
    if (g) return [{ href: `/ideas/${g.slug}#adopt`, title: g.title, by }];
    return [];
  });
}
// What's happening now, and the most used free alternatives, with their GitHub pictures.
let topProjects: { fullName: string; description: string | null; stars: number; license: string | null; pushedAt: string | null; replaces: string[] }[] = [];
if (db) {
  const { data } = await db
    .from('project_products')
    .select('source, products(name), projects!inner(full_name, description, stars, license_spdx, license_name, pushed_at, listed)')
    .eq('projects.listed', true)
    .eq('source', 'catalog')
    .limit(400);
  const byRepo = new Map<string, (typeof topProjects)[number]>();
  for (const r of (data ?? []) as any[]) {
    const p = r.projects;
    const cur = byRepo.get(p.full_name) ?? { fullName: p.full_name, description: p.description, stars: p.stars, license: p.license_spdx ?? (p.license_name ? 'Own license' : null), pushedAt: p.pushed_at, replaces: [] as string[] };
    if (r.products?.name && !cur.replaces.includes(r.products.name)) cur.replaces.push(r.products.name);
    byRepo.set(p.full_name, cur);
  }
  topProjects = [...byRepo.values()].sort((a, b) => b.stars - a.stars).slice(0, 8);
}
const now = new Date();
// Categories for the Explore section, biggest first.
const catFree = new Map<string, number>();
for (const p of products) catFree.set(p.category, (catFree.get(p.category) ?? 0) + p.freeOptions);
const exploreCats = [...catFree].filter(([n]) => n !== 'Other').map(([name, free]) => ({ name, free })).sort((a, b) => b.free - a.free).slice(0, 12);
const topTopics = [...topics].sort((a, b) => b.count - a.count).slice(0, 14);
const paints = ['p4', 'p6', 'p3', 'p2', 'p5', 'p1'];
const builderCount = stats?.builders ?? null;
---

<Platform
  title={`${site.name}: take down the paywall, brick by brick`}
  bareTitle
  description="Find the free, open-source version of the software you pay for. If it doesn't exist yet, help build it."
>
  <script slot="head" is:inline src="/wall-boot.js"></script>

  <section class="hero">
    <Wall ideas={wallIdeas} products={wallProducts} yoursHref="/ideas/new" roomy />
    <div class="wrap hero-body">
      <div class="hero-content" data-clear>
        <h1 class="display hero-title">Take down the paywall, brick by brick.</h1>
        <p class="lede hero-lede">Find the free, open-source version of the software you pay for. If it doesn’t exist yet, help build it.</p>
        <div class="hero-find">
          <InstantSearch id="q" big placeholder="What do you pay for?" button="Find it free" />
        </div>
      </div>
    </div>
    <p class="hint chip" aria-hidden="true">Each brick is something people pay for. Knock one out to see what's free.{wallIdeas.length > 0 && ' The bold ones are wanted ideas.'}</p>
  </section>

  <div>
    <section class="wrap hm-open">
      {platform && (
        <p class="hm-say">
          <a href="/explore?show=all">{platform.projects.toLocaleString('en-US')} open-source projects</a> already do the job of{' '}
          <a href="/free-alternatives">{platform.products} tools people pay for</a>.{' '}
          {platform.gaps + openGaps.length > 0 && <><a href="#gaps-h">{platform.gaps + openGaps.length} {platform.gaps + openGaps.length === 1 ? 'thing is' : 'things are'} still missing</a>.</>}
        </p>
      )}
    </section>

    <section class="wrap hm-gaps" aria-labelledby="gaps-h">
      <div class="pf-head-row">
        <div style="display:grid;gap:10px">
          <h2 id="gaps-h" class="pf-h2">Holes in the wall.</h2>
          <p class="lede">What nobody has built yet: the things people asked for, and the paid tools we found with no free version people rely on. Back one and it moves up. The most wanted become hackathon briefs.</p>
        </div>
        <a class="key key-milk key-sm" href="/ideas">See everything wanted</a>
      </div>
      <ul class="hm-slots">
        {nobody.map((g) => (
          <li class="hm-slot">
            <a href={`/ideas/${g.slug}`}>{g.title}</a>
            <div class="hm-slot-foot">
              <span class="num">{g.want > 0 ? `${g.want} want it` : 'Be the first to want it'}{g.pay > 0 ? `, ${g.pay} would pay` : ''}</span>
              <Heart slug={g.slug} hearts={g.want} hearted={g.hearted} />
            </div>
          </li>
        ))}
        {openGaps.slice(0, Math.max(2, 8 - nobody.length)).map((g) => (
          <li class="hm-slot">
            <a href={`/free-alternatives/${g.slug}`}>A free {g.name}</a>
            <div class="hm-slot-foot">
              <span>{g.freeOptions === 0 ? 'No free version found' : 'No free version many people use yet'}{priceLabel(g.price) ? `. Costs ${priceLabel(g.price)}` : ''}</span>
            </div>
          </li>
        ))}
        <li class="hm-slot hm-slot-yours">
          <a href="/ideas/new">Your idea here</a>
          <div class="hm-slot-foot"><span>Say what you wish was free. It takes a minute.</span><span class="hm-plus" aria-hidden="true">+</span></div>
        </li>
      </ul>
    </section>

    <section class="hm-season" aria-labelledby="season-h">
      <div class="wrap hm-season-in">
        <div class="hm-season-main">
          <p class="hm-season-kick"><span class="pulse"></span>The {site.name} Hackathon, Season 1</p>
          <h2 id="season-h">One week to fill the holes. Builders pick the winners.</h2>
          <p class="hm-season-sub">Free to enter. The community funds the prize pool, and nobody takes a cut. Dates are set once {need} builders are in.</p>
          <div class="hm-season-go">
            <a class="key key-marigold key-big" href="/hackathon/join">Join Season 1</a>
            <a class="hm-season-more" href="/hackathon">How it works</a>
          </div>
        </div>
        <div class="hm-season-side">
          {stats && (
            <a class="hm-pool" href="/hackathon/pool">
              <b class="num">{usd(site.collective.pending ? stats.pledgedCents : stats.balanceCents)}</b>
              <span>{site.collective.pending ? 'pledged to the prize pool so far' : 'in the prize pool right now'}</span>
            </a>
          )}
          {builderCount !== null && (
            <a class="hm-crew" href="/hackathon/builders" aria-label={`${builderCount} of ${need} builders have joined`}>
              <span class="hm-crew-bricks" aria-hidden="true">
                {Array.from({ length: Math.min(need, 100) }, (_, i) => <i class={i < Math.round((Math.min(builderCount, need) / need) * Math.min(need, 100)) ? 'on' : undefined}></i>)}
              </span>
              <span class="hm-crew-n"><b class="num">{builderCount}</b> of {need} builders in. Each brick is a seat.</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="wrap pf-section">
      <div class="pf-head-row">
        <div style="display:grid;gap:10px">
          <h2 class="pf-h2">What do you pay for?</h2>
          <p class="lede">The everyday subscriptions, and the open-source projects people use in their place.</p>
        </div>
        <a class="key key-milk key-sm" href="/free-alternatives">All {products.length} paid tools</a>
      </div>
      {featured.length ? (
        <div class="hm-pay">
          {featured.map((p, i) => (
            <a class={`pf-brick ${paints[i % 6]}`} href={`/free-alternatives/${p.slug}`}>
              <span class="hm-pay-top"><b>{p.name}</b>{priceLabel(p.price) && <s>{priceLabel(p.price)!.replace('about ', '')}</s>}</span>
              <span class="hm-pay-what">{p.blurb}</span>
              <span class="hm-pay-free">
                {leadFree.get(p.slug) ? <>Free: <b>{leadFree.get(p.slug)}</b>{p.freeOptions > 1 && ` and ${p.freeOptions - 1} more`}</> : `${p.freeOptions} free ${p.freeOptions === 1 ? 'alternative' : 'alternatives'}`}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="pf-empty"><p>The directory is filling up from GitHub.</p></div>
      )}
    </section>

    <section class="pf-band hm-explore" aria-labelledby="explore-h">
      <div class="wrap pf-section">
        <div class="pf-head-row">
          <div style="display:grid;gap:10px">
            <h2 id="explore-h" class="pf-h2">Explore all {platform?.projects.toLocaleString('en-US') ?? ''} projects.</h2>
            <p class="lede">Every open-source project we follow on GitHub, with its stars, license, contributors and what it needs help with. Filter by what it replaces, topic or license.</p>
          </div>
          <a class="key key-big" href="/explore">Open Explore</a>
        </div>
        <ul class="hm-cats">
          {exploreCats.map((c, i) => (
            <li><a class={paints[i % 6]} href={`/explore?category=${encodeURIComponent(c.name)}`}><b>{c.name}</b><span class="num">{c.free} free</span></a></li>
          ))}
        </ul>
        {topProjects.length > 0 && (
          <>
            <h3 class="pf-h3" style="margin-top:14px">The ones people switch to most</h3>
            <div class="pf-grid">
              {topProjects.map((p) => <ProjectCard {...p} />)}
            </div>
          </>
        )}
        {topTopics.length > 0 && (
          <div class="pf-chips" style="align-items:center;margin-top:6px">
            <span class="muted small" style="font-weight:700">By topic</span>
            {topTopics.map((t) => <a class="chip" href={`/explore?show=all&topic=${t.slug}`}>{t.name} <span class="muted num">{t.count}</span></a>)}
            <a class="chip" href="/topics">All topics</a>
          </div>
        )}
      </div>
    </section>

    {
      help.length > 0 && (
        <section class="wrap pf-section">
          <div style="display:grid;gap:10px">
            <h2 class="pf-h2">Want to build? Start here.</h2>
            <p class="lede">Open issues the maintainers of free alternatives asked for help with. Pick one and open a pull request.</p>
          </div>
          <div class="pf-grid pf-grid-wide">
            {help.map((i, n) => (
              <a class={`pf-brick ${paints[(n + 2) % 6]}`} href={i.url} rel="noopener">
                <small>{i.repo} · {i.label}</small>
                <b style="font-size:1.2rem">{i.title}</b>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      handoffs.length > 0 && (
        <section class="wrap pf-section pf-section-tight">
          <div style="display:grid;gap:10px">
            <h2 class="pf-h2">Looking for a new owner.</h2>
            <p class="lede">Builders moving on from something they started, on their own terms. Pick it up and carry it forward.</p>
          </div>
          <ul class="pf-list">
            {handoffs.map((h) => <li class="pf-row-flat"><div><a href={h.href}>{h.title}</a><div class="muted small">Offered by @{h.by}</div></div></li>)}
          </ul>
        </section>
      )
    }

    <section class="pf-band hm-why" aria-labelledby="why-h">
      <div class="wrap pf-section">
        <div class="hm-why-top">
          <div class="hm-why-say">
            <h2 id="why-h" class="pf-h2">Finding the gap is half of it. The hackathon builds it.</h2>
            <p class="lede">
              Antipaywall exists to find software people pay for that has no good free version. The hackathon is how those gaps get filled:
              each season the most wanted ideas become the briefs, builders get one week, and the builders themselves vote on who wins the prize pool.
            </p>
            <p class="lede">Season 1 is the first. Its dates are set once {need} builders are in.</p>
            <div class="pf-chips">
              <a class="key key-marigold" href="/hackathon/join">Join Season 1</a>
              <a class="key key-milk" href="/hackathon">How the hackathon works</a>
            </div>
          </div>
          <ol class="hm-why-steps">
            <li><b>People say what's missing</b><span>Ideas and "me too"s show what's wanted most.</span></li>
            <li><b>The top ideas become briefs</b><span>Each season takes on the most wanted gaps.</span></li>
            <li><b>Builders get one week</b><span>Free to enter. Everything built is open source.</span></li>
            <li><b>Builders vote, winners are paid in public</b><span>The community funds the pool. Antipaywall takes nothing.</span></li>
          </ol>
        </div>
        {builders && builders.length > 0 && (
          <>
            <h3 class="pf-h3" style="margin-top:18px">{builderCount ?? builders.length} builders are in for Season 1</h3>
            <ul class="crew-list hm-crew-grid">
              {builders.map((b) => <BuilderTile builder={b} badge={builderBadges.get(b.id)} />)}
              <li class="hm-crew-more"><a class="tile tile-more" href="/hackathon/builders"><span>{builderCount ?? ''}</span>See every builder</a></li>
            </ul>
          </>
        )}
      </div>
    </section>

    <section class="wrap hm-how" aria-labelledby="how-h">
      <div class="hm-how-head">
        <h2 id="how-h" class="pf-h2">Every search lays a brick.</h2>
        <p class="lede">Nobody runs a queue or picks winners behind a door. What people look for, back and build is what moves.</p>
      </div>
      <ol class="hm-stairs">
        <li class="p4"><div class="hm-step"><b>Find</b><span>Search a tool you pay for. The free, open-source versions come straight from GitHub.</span></div></li>
        <li class="p2"><div class="hm-step"><b>Say what's missing</b><span>Mark what you use and what you still need. No code, no account to browse.</span></div><i></i></li>
        <li class="p3"><div class="hm-step"><b>Help build it</b><span>Every project lists what it needs help with. The most wanted gaps become hackathon briefs.</span></div><i></i><i></i></li>
        <li class="p1"><div class="hm-step"><b>It's free for everyone</b><span>What gets built is open source. One more thing nobody has to pay for.</span></div><i></i><i></i><i></i></li>
      </ol>
      <p class="muted hm-how-note">The catalog, the matching and the GitHub sync are all in <a class="link" href={site.repo} rel="noopener">the public repo</a>, and the data is free to download.</p>
    </section>

    <section class="hm-end" aria-labelledby="end-h">
      <div class="wrap hm-end-in">
        <h2 id="end-h">What are you still paying for?</h2>
        <p class="lede">Look it up. If a free version exists, it's here. If it doesn't, say so, and the people who can build it will see it.</p>
        <InstantSearch id="q2" big placeholder="Type a tool you pay for" button="Find it free" />
        <div class="hm-end-or">
          {!Astro.locals.person && <a class="key key-milk" href="/signin?next=%2F">Sign in with GitHub</a>}
          <a class="key key-milk" href="/ideas/new">Post something you want</a>
          <a class="key key-milk" href="/explore">Explore projects</a>
        </div>
      </div>
    </section>
  </div>
</Platform>
