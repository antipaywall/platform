---
import Platform from '../../layouts/Platform.astro';
import FollowButton from '../../components/pf/FollowButton.astro';
import SignalScript from '../../components/pf/SignalScript.astro';
import { site } from '../../config/site';
import ProjectCard from '../../components/pf/ProjectCard.astro';
import { getTopicPage, type TopicPage, type TopicSort } from '../../lib/topics';
import { adminClient } from '../../lib/supabase';

const slug = String(Astro.params.slug).toLowerCase();
if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) return new Response(null, { status: 404 });
const sortParam = Astro.url.searchParams.get('sort');
const sort: TopicSort = sortParam === 'growth' || sortParam === 'active' ? sortParam : 'stars';
const db = adminClient();
if (!db) return new Response('This page is unavailable right now. Try again in a minute.', { status: 503, headers: { 'retry-after': '60' } });
let page: TopicPage | null;
try {
  page = await getTopicPage(db, slug, sort, new Date());
} catch {
  return new Response('This page is unavailable right now. Try again in a minute.', { status: 503, headers: { 'retry-after': '60' } });
}
if (!page) return new Response(null, { status: 404 });
const { topic, projects, products, gaps, total } = page;
const here = `/topics/${topic.slug}`;
let following = false;
if (topic.id && Astro.locals.person) {
  const f = await db.from('follows').select('follower_id').eq('follower_id', Astro.locals.person.id).eq('subject_kind', 'topic').eq('subject_id', topic.id).limit(1);
  following = (f.data ?? []).length > 0;
}
const title = `Free, open-source ${topic.name.toLowerCase()} software`;
const description = `${total} open-source ${topic.name.toLowerCase()} projects from GitHub${products.length ? `, as free alternatives to ${products.slice(0, 3).map((p) => p.name).join(', ')}` : ''}.`;
const sorts: [TopicSort, string][] = [['stars', 'Most stars'], ['growth', 'Growing fastest'], ['active', 'Recently updated']];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  url: new URL(here, site.origin).href,
  itemListElement: projects.slice(0, 20).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/projects/${p.fullName}`, site.origin).href, name: p.name })),
};
---

<Platform title={title} description={description.slice(0, 160)} jsonLd={jsonLd} noindex={!topic.tracked}>
  <section class="wrap pf-hero">
    <div class="pf-hero-main">
      <nav aria-label="Breadcrumb" class="pf-crumbs"><a href="/topics">Topics</a><span aria-hidden="true">/</span><span>{topic.name}</span></nav>
      <h1 class="pf-title">{title}</h1>
      <p class="lede">{topic.blurb ? `${topic.blurb} ` : ''}Every project here is public, open source and pulled from GitHub, where it carries the "{topic.slug}" topic.</p>
      <div class="pf-chips">
        <a class="chip num" href={`/explore?show=all&topic=${topic.slug}`}>{total.toLocaleString('en-US')} {total === 1 ? 'project' : 'projects'}</a>
        {topic.id && <FollowButton kind="topic" id={topic.id} following={following} next={here} label="Follow this topic" signedIn={Boolean(Astro.locals.person)} />}
      </div>
    </div>
    {products.length > 0 && (
      <aside class="pf-hero-side" style="display:grid;gap:10px">
        <h2 class="pf-h3" style="font-size:1.25rem">Paid products these replace</h2>
        <div class="pf-grid" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,150px),1fr))">
          {products.map((p) => <a class="tp-product" href={`/free-alternatives/${p.slug}`}>Free {p.name}<span aria-hidden="true">→</span></a>)}
        </div>
      </aside>
    )}
  </section>

  <section class="wrap pf-section pf-section-tight">
    <div class="pf-head-row">
      <p class="pf-sub" style="margin:0">{total > projects.length ? `The top ${projects.length} of ${total.toLocaleString('en-US')}` : `${total} ${total === 1 ? 'project' : 'projects'}`}</p>
      <nav class="tp-sort" aria-label="Sort projects">
        {sorts.map(([key, label]) => <a href={key === 'stars' ? here : `${here}?sort=${key}`} aria-current={sort === key ? 'true' : undefined}>{label}</a>)}
      </nav>
    </div>
    {projects.length ? (
      <>
      <div class="pf-grid">
        {projects.map((p) => <ProjectCard fullName={p.fullName} description={p.description} stars={p.stars} license={p.license} pushedAt={p.pushedAt} gained={p.gained} />)}
      </div>
      {total > projects.length && <a class="key key-milk" style="justify-self:center" href={`/explore?show=all&topic=${topic.slug}`}>See all {total.toLocaleString('en-US')} in Explore</a>}
      </>
    ) : (
      <div class="pf-empty"><p>No projects listed under this topic yet. The next GitHub sync may find some.</p></div>
    )}
  </section>

  {
    gaps.length > 0 && (
      <section class="pf-band">
        <div class="wrap pf-section">
          <h2 class="pf-h2">Still wanted here</h2>
          <ul class="pf-list">
            {gaps.map((g) => <li class="pf-row-flat"><div><a href={`/ideas/${g.slug}`}>{g.title}</a></div><span class="muted num">{g.want} want it</span></li>)}
          </ul>
        </div>
      </section>
    )
  }
  <SignalScript />
</Platform>

<style>
  .tp-product { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 12px 14px; border-radius: 14px; background: var(--card); box-shadow: 0 0 0 1px var(--line); font-weight: 800; text-decoration: none; color: var(--ink); }
  .tp-product:hover { box-shadow: 0 0 0 1.5px var(--ink); }
  .tp-sort { display: flex; gap: 4px; padding: 4px; border-radius: 14px; background: var(--milk-2); overflow-x: auto; scrollbar-width: none; max-width: 100%; }
  .tp-sort a { padding: 7px 12px; border-radius: 10px; text-decoration: none; color: var(--ink-2); font-weight: 700; font-size: 0.875rem; white-space: nowrap; }
  .tp-sort a[aria-current='true'] { background: var(--card); color: var(--ink); box-shadow: 0 0 0 1px var(--line); }
</style>
