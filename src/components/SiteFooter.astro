---
// The footer: every part of the site in four columns, what Antipaywall promises about money, and
// the wordmark as big as the page.
import { money, site } from '../config/site';

const person = Astro.locals.person;
const cols: { title: string; links: [string, string][] }[] = [
  { title: 'Find', links: [['/free-alternatives', 'Free alternatives'], ['/explore', 'Explore projects'], ['/topics', 'Topics'], ['/search', 'Search']] },
  { title: 'Take part', links: [['/ideas', 'What people want'], ['/ideas/new', 'Post an idea'], ['/feed', 'Feed'], ['/builders', 'Builders'], ['/agents', 'For coding agents']] },
  { title: 'Hackathon', links: [['/hackathon', 'Season 1'], ['/hackathon/join', 'Join'], ['/hackathon/rules', 'Rules'], ['/hackathon/pool', 'Prize pool'], ['/hackathon/fund', 'Pledge'], ['/hackathon/faq', 'Questions']] },
  { title: 'In the open', links: [[site.repo, 'Code on GitHub'], [`${site.repo}/blob/main/docs/run-locally.md`, 'Run it yourself'], [`${site.repo}/blob/main/CONTRIBUTING.md`, 'Contribute'], ['/hackathon/about', 'About'], ['/privacy', 'Privacy'], ['/terms', 'Terms']] },
];
---

<div class="sf" data-footer>
  <div class="sf-course" aria-hidden="true">{Array.from({ length: 16 }, () => <i></i>)}</div>
  <div class="sf-wall" data-footer-wall aria-hidden="true"></div>
  <div class="wrap sf-top">
    <div class="sf-lead">
      <a class="sf-brand" href="/" aria-label={`${site.name} home`}><span>anti</span>paywall</a>
      <p class="sf-say">Free software for everything you pay for, found or built in the open.</p>
      <p class="sf-money">{money.none}</p>
      {!person && <a class="key key-marigold" href="/signin">Sign in with GitHub</a>}
    </div>
    <nav class="sf-cols" aria-label="Footer">
      {cols.map((c) => (
        <div>
          <h2>{c.title}</h2>
          <ul>
            {c.links.map(([href, label]) => <li><a href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <p class="sf-mark" aria-hidden="true"><span>anti</span>paywall</p>
</div>

<script>
  // The footer starts bricked up. When it scrolls into view the bricks drop away, a few at a time,
  // and what was behind them is the footer. Without scripts, or with reduced motion, there is no
  // wall: the footer is simply there.
  const foot = document.querySelector<HTMLElement>('[data-footer]');
  const wall = document.querySelector<HTMLElement>('[data-footer-wall]');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (foot && wall && !calm && 'IntersectionObserver' in window) {
    const paints = ['var(--marigold)', 'var(--mint)', 'var(--tomato)', 'var(--sky)', 'var(--lilac)', 'var(--pink)'];
    let seed = 11;
    const rand = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
    const build = () => {
      const W = foot.clientWidth;
      const H = foot.clientHeight;
      const bw = W < 700 ? 104 : 130;
      const bh = 44;
      const gap = 7;
      const top = bh + gap * 2; // under the course that stays
      const rows = Math.ceil((H - top) / (bh + gap));
      const cols = Math.ceil(W / (bw + gap)) + 2;
      const frag = document.createDocumentFragment();
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const b = document.createElement('i');
          const x = c * (bw + gap) - (r % 2 ? 0 : (bw + gap) / 2) - gap;
          const y = top + r * (bh + gap);
          const painted = rand() < 0.07;
          // Lower courses go first, so the wall comes down from the bottom up, with some scatter.
          const delay = Math.round((rows - 1 - r) * 55 + rand() * 260);
          b.style.cssText = `left:${x}px;top:${y}px;width:${bw}px;height:${bh}px;--d:${delay}ms;--r:${Math.round(rand() * 50 - 25)}deg;--x:${Math.round(rand() * 80 - 40)}px;--fall:${H - y + 80}px;${painted ? `background:${paints[Math.floor(rand() * 6)]};` : `--t:${rand().toFixed(2)};`}`;
          frag.append(b);
        }
      }
      wall.replaceChildren(frag);
    };
    build();
    foot.classList.add('sf-walled');
    let done = false;
    const drop = () => {
      if (done) return;
      done = true;
      foot.classList.add('sf-open');
      window.setTimeout(() => wall.remove(), 2600);
    };
    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          window.setTimeout(drop, 180);
        }
      },
      { threshold: 0.3 },
    ).observe(foot);
    let resize = 0;
    window.addEventListener('resize', () => {
      if (done) return;
      clearTimeout(resize);
      resize = window.setTimeout(build, 150);
    });
  }
</script>

<style>
  /* The wall that covers the footer until it is scrolled into view. */
  .sf-wall { position: absolute; inset: 0; z-index: 2; pointer-events: none; display: none; }
  .sf-walled .sf-wall { display: block; background: var(--wall, var(--ink)); transition: background-color 500ms linear 250ms; }
  .sf-wall :global(i) {
    position: absolute; border-radius: 12px; background: oklch(calc(0.27 + var(--t, 0.5) * 0.04) 0.045 310);
    box-shadow: inset 0 -5px 0 rgb(0 0 0 / 0.28), inset 0 1px 0 rgb(255 255 255 / 0.08);
    transition: transform 900ms cubic-bezier(0.5, 0, 0.9, 0.4) var(--d), opacity 300ms linear calc(var(--d) + 650ms);
    will-change: transform;
  }
  .sf-open .sf-wall { background-color: transparent; }
  .sf-open .sf-wall :global(i) { transform: translate(var(--x), var(--fall)) rotate(var(--r)); opacity: 0; }

  .sf { position: relative; overflow: hidden; background: var(--wall, var(--ink)); color: oklch(0.8 0.03 310); }
  /* The top edge is a course of the wall's own bricks. */
  .sf-course { display: flex; gap: 7px; margin: 0 -60px; padding-top: 7px; }
  .sf-course i { flex: 1 0 130px; height: 44px; border-radius: 12px; background: oklch(0.29 0.045 310); box-shadow: inset 0 -5px 0 var(--wall-edge, oklch(0.17 0.04 310)), inset 0 1px 0 rgb(255 255 255 / 0.08); }
  .sf-course i:nth-child(3n) { background: oklch(0.27 0.045 310); }
  .sf-course i:nth-child(5) { background: var(--marigold); box-shadow: inset 0 -5px 0 oklch(0.72 0.14 78); }
  .sf-course i:nth-child(11) { background: var(--mint); box-shadow: inset 0 -5px 0 oklch(0.7 0.1 165); }
  .sf-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: clamp(36px, 6vw, 96px); padding-block: clamp(48px, 6vw, 88px) clamp(40px, 5vw, 72px); }
  .sf-lead { display: grid; gap: 16px; justify-items: start; align-content: start; }
  .sf-brand { font: 900 1.9rem/1 var(--display); letter-spacing: -0.04em; color: #fff; text-decoration: none; }
  .sf-brand span, .sf-mark span { text-decoration: line-through; text-decoration-color: var(--tomato); text-decoration-thickness: 0.11em; color: oklch(0.6 0.04 310); }
  .sf-say { margin: 0; font: 800 clamp(1.4rem, 2.2vw, 1.9rem)/1.12 var(--display); letter-spacing: -0.025em; color: #fff; max-width: 18ch; text-wrap: balance; }
  .sf-money { margin: 0 0 6px; font-size: 0.9375rem; max-width: 34ch; }
  .sf-cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 24px; }
  .sf-cols h2 { margin: 0 0 14px; font: 800 1.0625rem/1 var(--display); letter-spacing: -0.01em; color: var(--marigold); }
  .sf-cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .sf-cols a { display: inline-block; padding: 5px 0; color: #fff; font-weight: 500; text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 calc(100% - 3px) / 0 1.5px no-repeat; transition: background-size 200ms var(--out); }
  .sf-cols a:hover { background-size: 100% 1.5px; }
  .sf-cols a:focus-visible, .sf-brand:focus-visible { outline: 2px solid var(--marigold); outline-offset: 3px; border-radius: 4px; }
  .sf-mark { margin: 0 0 -0.05em; font: 900 clamp(4rem, 19.5vw, 22rem)/0.74 var(--display); letter-spacing: -0.055em; color: var(--milk); text-align: center; white-space: nowrap; user-select: none; }
  @media (max-width: 900px) {
    .sf-top { grid-template-columns: 1fr; }
    .sf-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .sf-cols a { transition: none; } }
</style>
