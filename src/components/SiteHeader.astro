---
// The site header: wordmark, page links, and the way in. It stays at the top of the
// screen on every page. On a phone the page links move into a menu that works with or
// without scripts (it is a <details> element).
import { site } from '../config/site';
import { providerName, providerOf } from '../lib/accounts';
import { isAdmin } from '../lib/db';
import { isPublic, profilePath } from '../lib/profiles';

const person = Astro.locals.person;
const here = Astro.url.pathname;
const cur = (on: boolean) => (on ? 'page' : undefined);
const links = [
  { href: '/', label: 'Find', on: here === '/' || here.startsWith('/free-alternatives') || here === '/search' },
  { href: '/explore', label: 'Explore', on: here.startsWith('/explore') || here.startsWith('/projects') || here.startsWith('/topics') },
  { href: '/ideas', label: 'Wanted', on: here.startsWith('/ideas') },
  { href: '/feed', label: 'Feed', on: here.startsWith('/feed') },
  { href: '/builders', label: 'Builders', on: here.startsWith('/builders') },
  { href: '/hackathon', label: 'Hackathon', on: here.startsWith('/hackathon') },
];
// The hackathon is its own section: inside it, a second, smaller menu.
const inHackathon = here === '/hackathon' || here.startsWith('/hackathon/');
const section = [
  { href: '/hackathon', label: 'Season 1', on: here === '/hackathon' },
  { href: '/hackathon/rules', label: 'Rules', on: here === '/hackathon/rules' },
  { href: '/hackathon/pool', label: 'Pool', on: here === '/hackathon/pool' },
  { href: '/hackathon/fund', label: 'Pledge', on: here === '/hackathon/fund' },
  { href: '/hackathon/sponsor', label: 'Sponsor', on: here === '/hackathon/sponsor' },
  { href: '/hackathon/builders', label: 'Builders', on: here === '/hackathon/builders' },
  { href: '/hackathon/about', label: 'About', on: here === '/hackathon/about' },
  { href: '/hackathon/faq', label: 'Questions', on: here === '/hackathon/faq' },
];
const more = [
  ...section.filter((l) => l.href !== '/hackathon'),
  { href: '/hackathon/join', label: 'Join the hackathon', on: here.startsWith('/hackathon/join') },
];

const admin = isAdmin(person) ? [{ href: '/admin', label: 'Admin', on: here === '/admin' }] : [];
// Everything that is yours, in the account menu and at the bottom of the phone menu.
const mine = person
  ? [
      ...(isPublic(person) ? [{ href: profilePath(person), label: 'Your profile' }] : []),
      { href: '/account', label: 'Edit profile' },
      { href: '/account#activity', label: 'Your pledge and ideas' },
      { href: '/account#email', label: 'Email' },
    ]
  : [];
---

<header class="site-head" data-site-head>
  <div class="wrap bar-top">
    <a class="brand" href="/" aria-label={`${site.name} home`}><span class="brand-anti">anti</span>paywall</a>
    <nav class="bar-links" aria-label="Main">
      {[...links, ...admin].map((l) => <a href={l.href} aria-current={cur(l.on)}>{l.label}</a>)}
    </nav>
    {
      person ? (
        <details class="me" data-pop>
          <summary aria-label={`Your account, signed in as ${person.handle}`}>
            {person.avatar_url && <img src={person.avatar_url} alt="" width="32" height="32" />}
            <span>{person.handle}</span>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </summary>
          <div class="me-panel">
            <div class="me-head">
              {person.avatar_url && <img src={person.avatar_url} alt="" width="44" height="44" />}
              <div>
                <b>{person.name ?? person.handle}</b>
                <span>@{person.handle} on {providerName(providerOf(person))}</span>
                {person.is_builder && <span class="me-badge">Builder</span>}
              </div>
            </div>
            <nav aria-label="Your account">
              {mine.map((l) => <a href={l.href}>{l.label}</a>)}
            </nav>
            <form method="post" action="/auth/signout"><button type="submit">Sign out</button></form>
          </div>
        </details>
      ) : (
        <a class="key top-join" href={`/signin?next=${encodeURIComponent(here)}`}>
          <svg aria-hidden="true" viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.33.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
          <span class="top-join-long">Sign in with GitHub</span><span class="top-join-short">Sign in</span>
        </a>
      )
    }
    <details class="menu" data-menu>
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
      </summary>
      <nav class="menu-panel" aria-label="All pages">
        {[...links, ...more, ...admin].map((l) => <a href={l.href} aria-current={cur(l.on)}>{l.label}</a>)}
        {
          person && (
            <div class="menu-who">
              <span>Signed in as {person.handle}</span>
              {mine.map((l) => <a href={l.href}>{l.label}</a>)}
              <form method="post" action="/auth/signout"><button type="submit">Sign out</button></form>
            </div>
          )
        }
      </nav>
    </details>
  </div>
  {
    inHackathon && (
      <nav class="wrap hack-nav" aria-label="Hackathon">
        {section.map((l) => <a href={l.href} aria-current={cur(l.on)}>{l.label}</a>)}
        <a class="hack-join" href="/hackathon/join" aria-current={cur(here.startsWith('/hackathon/join'))}>Join</a>
      </nav>
    )
  }
</header>

<script>
  // Extras only: the header and the menu work without any of this.
  const head = document.querySelector<HTMLElement>('[data-site-head]');
  const pops = document.querySelectorAll<HTMLDetailsElement>('[data-menu], [data-pop]');
  if (head) {
    const mark = () => head.classList.toggle('is-scrolled', window.scrollY > 4);
    mark();
    addEventListener('scroll', mark, { passive: true });
  }
  // Both the phone menu and the account menu close on Escape, on a click outside, and after a link is picked.
  for (const pop of pops) {
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && pop.open) {
        pop.open = false;
        pop.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (pop.open && (!pop.contains(t) || (t as HTMLElement).closest?.('a'))) pop.open = false;
    });
  }
</script>
