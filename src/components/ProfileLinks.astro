---
// A builder's three links as icons: their GitHub or GitLab account, X and website.
// One they haven't added is shown greyed out and is not a link, so every row looks the same.
import { profileUrl, providerName, type Provider } from '../lib/accounts';

interface Props {
  provider: Provider;
  handle: string;
  xHandle: string | null;
  siteUrl: string | null;
  size?: 'small' | 'big';
}
const { provider, handle, xHandle, siteUrl, size = 'small' } = Astro.props;
const gh =
  'M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.33.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z';
const gl =
  'm23.6 9.59-.03-.09L20.3.98a.85.85 0 0 0-.34-.4.87.87 0 0 0-1 .05.87.87 0 0 0-.29.44l-2.2 6.75H7.54L5.33 1.07a.86.86 0 0 0-.29-.44.87.87 0 0 0-1-.05.86.86 0 0 0-.34.4L.43 9.5l-.03.09a6.07 6.07 0 0 0 2.01 7.01l.01.01.03.02 4.98 3.73 2.46 1.86 1.5 1.13a1.01 1.01 0 0 0 1.22 0l1.5-1.13 2.46-1.86 5.01-3.75.01-.01a6.07 6.07 0 0 0 2-7z';
const x = 'M18.9 1.2h3.7l-8 9.1L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9Zm-1.3 19.4h2L6.5 3.3H4.3l13.3 17.3Z';
const name = providerName(provider);
---

<span class:list={['plinks', size === 'big' && 'plinks-big']}>
  <a class="plink" href={profileUrl(provider, handle)} rel="noopener" aria-label={`${handle} on ${name}`} title={`${handle} on ${name}`}>
    {provider === 'gitlab' ? <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={gl}></path></svg> : <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={gh}></path></svg>}
  </a>
  {
    xHandle ? (
      <a class="plink" href={`https://x.com/${xHandle}`} rel="noopener nofollow ugc" aria-label={`@${xHandle} on X`} title={`@${xHandle} on X. Added by the builder, not verified.`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={x}></path></svg>
      </a>
    ) : (
      <span class="plink plink-off" title="No X account added">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={x}></path></svg>
        <span class="sr">No X account added</span>
      </span>
    )
  }
  {
    siteUrl ? (
      <a class="plink" href={siteUrl} rel="noopener nofollow ugc" aria-label="Website" title={`${new URL(siteUrl).hostname}. Added by the builder, not verified.`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M2.5 12h19M12 2.5c2.6 2.8 3.9 6 3.9 9.5s-1.3 6.7-3.9 9.5c-2.6-2.8-3.9-6-3.9-9.5S9.4 5.3 12 2.5Z"></path></svg>
      </a>
    ) : (
      <span class="plink plink-off" title="No website added">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M2.5 12h19M12 2.5c2.6 2.8 3.9 6 3.9 9.5s-1.3 6.7-3.9 9.5c-2.6-2.8-3.9-6-3.9-9.5S9.4 5.3 12 2.5Z"></path></svg>
        <span class="sr">No website added</span>
      </span>
    )
  }
</span>
