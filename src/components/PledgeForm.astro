---
import SignIn from './SignIn.astro';
import { money, site } from '../config/site';

interface Props {
  /** Preselect "company", for people arriving from the sponsor page. */
  company?: boolean;
}
const { company = false } = Astro.props;
const person = Astro.locals.person;
const handle = person?.handle ?? '';
const hold = '$' + site.pledgeHold.aboveUsd.toLocaleString('en-US');
---

<form class="card stack" method="post" action="/api/pledge" data-pledge-form>
  <p class="h2">Pledge to the pool</p>
  <fieldset class="choice">
    <legend>Pledging as</legend>
    <label><input type="radio" name="kind" value="individual" checked={!company} /> <span>An individual</span></label>
    <label><input type="radio" name="kind" value="company" checked={company} /> <span>A company or brand</span></label>
  </fieldset>
  <div class="field">
    <label for="amount">Amount</label>
    <div class="money"><input class="input" id="amount" name="amount" inputmode="decimal" required placeholder="50" autocomplete="off" /></div>
  </div>
  <div class="field" data-named-only>
    <label for="display_name" data-name-label>Name to show</label>
    <input class="input" id="display_name" name="display_name" required maxlength="60" value={company ? '' : handle} data-handle={handle} aria-describedby="display_name_help" />
    <span class="help" id="display_name_help" data-name-help>Your username is shown beside it. A name other than your username is checked by a person before the pledge is listed.</span>
  </div>
  <div class="field">
    <label class="tick"><input type="checkbox" name="anonymous" aria-describedby="anonymous_help" /> <span>Keep me anonymous</span></label>
    <span class="help" id="anonymous_help">The public list shows "Anonymous" and the amount, and nothing else: no name, username, X account or website. The organizer still sees who pledged.</span>
  </div>
  <div class="field" data-company-only>
    <label for="company_url">Company website <span class="muted">(optional)</span></label>
    <input class="input" id="company_url" name="company_url" type="url" inputmode="url" maxlength="200" placeholder="https://" />
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input class="input" id="email" name="email" type="email" required maxlength="254" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="you@example.com" aria-describedby="email_help" />
    <span class="help" id="email_help">Never shown. We use it to reach you when the pool opens, and for nothing else.</span>
  </div>
  <div class="field" data-named-only>
    <label for="x_handle">X username <span class="muted">(optional)</span></label>
    <input class="input" id="x_handle" name="x_handle" maxlength="80" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="@name" aria-describedby="x_handle_help" />
    <span class="help" id="x_handle_help">If you add one, your pledge shows that account's picture and links to it. We can't confirm the account is yours automatically, so a pledge with an X username is checked by a person before it is listed.</span>
  </div>
  {
    person ? (
      <button class="key key-big" type="submit">Make this pledge</button>
    ) : (
      <SignIn next="/fund" label="Sign in with GitHub to pledge" gitlab />
    )
  }
  <p class="muted small">
    A pledge is a public promise, not a payment. It is listed, never counted as money in the pool,
    and you pay when the pool opens. A new pledge replaces your earlier one. It is listed
    straight away only if it is from an individual, is {hold} or less, and is either anonymous
    or shows your username as the name with no X username. Any other pledge is checked
    by a person first.
    {money.short}{' '}
    <a class="link" href="/terms">Terms</a>
  </p>
</form>

<script>
  // An individual sees no company website; an anonymous pledge asks for no name or X account.
  // Without scripts every field stays visible and the server still applies the same rules.
  const form = document.querySelector<HTMLFormElement>('[data-pledge-form]');
  if (form) {
    const name = form.querySelector<HTMLInputElement>('#display_name');
    const label = form.querySelector<HTMLElement>('[data-name-label]');
    const help = form.querySelector<HTMLElement>('[data-name-help]');
    const personal = help?.textContent ?? '';
    let was = '';
    const sync = () => {
      const data = new FormData(form);
      const company = data.get('kind') === 'company';
      const anonymous = data.has('anonymous');
      form.querySelectorAll<HTMLElement>('[data-company-only]').forEach((el) => (el.hidden = !company));
      form.querySelectorAll<HTMLElement>('[data-named-only]').forEach((el) => (el.hidden = anonymous));
      if (label) label.textContent = company ? 'Company or brand name to show' : 'Name to show';
      if (help) help.textContent = company ? 'Company pledges are checked by a person before they are listed. Your username is shown beside the name.' : personal;
      if (name) {
        name.required = !anonymous;
        // Switching kind swaps the prefilled handle out or back in, but never overwrites something typed.
        const kind = company ? 'company' : 'individual';
        if (was && was !== kind) {
          const handle = name.dataset.handle ?? '';
          if (company && name.value === handle) name.value = '';
          else if (!company && name.value === '') name.value = handle;
        }
        was = kind;
      }
    };
    form.addEventListener('change', sync);
    sync();
  }
</script>
