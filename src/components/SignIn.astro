---
// The sign-in buttons: GitHub first, GitLab beside it. They always say what signing in does before the click.
interface Props {
  next: string;
  label?: string;
  tone?: string;
}
const { next, label = 'Sign in with GitHub', tone = '' } = Astro.props;
// The same words for GitLab, so "Join with GitHub" becomes "Join with GitLab".
const gitlabLabel = label.includes('GitHub') ? label.replace('GitHub', 'GitLab') : 'Use GitLab instead';
const gl =
  'm23.6 9.59-.03-.09L20.3.98a.85.85 0 0 0-.34-.4.87.87 0 0 0-1 .05.87.87 0 0 0-.29.44l-2.2 6.75H7.54L5.33 1.07a.86.86 0 0 0-.29-.44.87.87 0 0 0-1-.05.86.86 0 0 0-.34.4L.43 9.5l-.03.09a6.07 6.07 0 0 0 2.01 7.01l.01.01.03.02 4.98 3.73 2.46 1.86 1.5 1.13a1.01 1.01 0 0 0 1.22 0l1.5-1.13 2.46-1.86 5.01-3.75.01-.01a6.07 6.07 0 0 0 2-7z';
const gh =
  'M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.33.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z';
---

<div class="signin">
  <div class="signin-keys">
    <a class:list={['key', 'key-big', tone]} href={`/auth/signin?next=${next}`}>
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d={gh}></path></svg>
      {label}
    </a>
    <a class="key key-milk" href={`/auth/signin?provider=gitlab&next=${next}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={gl}></path></svg>
      {gitlabLabel}
    </a>
  </div>
  <p class="muted small">
    Signing in adds the email on your GitHub or GitLab account to the Antipaywall email list. Unsubscribe any time.
    We read your public profile and that email address, never your private repositories.{' '}
    <a class="link" href="/privacy">What we record</a>{' '}
    <a class="link" href="/terms">Terms</a>
  </p>
</div>
